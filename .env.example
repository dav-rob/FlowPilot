# Optional JEV credentials. Live runs use the configured CLI classifier when absent.
# Export values in your shell before starting FlowPilot; this file is not loaded automatically.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Routing thresholds are provisional until calibrated against validation data.
FLOWPILOT_UNCERTAINTY_THRESHOLD=0.35
FLOWPILOT_MAX_ITERATIONS=14
FLOWPILOT_MAX_TOOL_CALLS=36
FLOWPILOT_MAX_PARALLEL=4
FLOWPILOT_MAX_MODEL_CALLS=17
FLOWPILOT_MAX_SECONDS=900
FLOWPILOT_MAX_CONTEXT_CHARS=180000
# Optional custom SQLite storage directory; defaults to .runtime in this checkout.
# FLOWPILOT_STATE_DIR=/absolute/private/path
